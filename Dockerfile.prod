# syntax=docker/dockerfile:1

# ===========================================================================
# Xperd One — production image (efficient multi-stage build)
#
#   docker build -f Dockerfile.prod -t ghcr.io/<org>/<repo>:<tag> .
#
# Efficiency highlights:
#   * Two stages — the heavy build tooling (Vite/Rolldown/Tailwind native
#     bindings) is discarded; only the tiny runtime image is shipped.
#   * BuildKit cache mount for npm -> rebuilds only re-fetch changed deps.
#   * Runtime = node:22-alpine (musl). The app is pure JS (Nitro bundles all
#     deps into .output/server/_libs — verified: no bare node_modules
#     requires), so no glibc/native addons are needed.
#   * Non-root user + healthcheck.
# ===========================================================================

# ---------- Stage 1: build ----------
FROM node:22-slim AS build
WORKDIR /app

# Locked deps first — this layer is cached unless package.json/lockfile change.
COPY package.json package-lock.json ./
# Cache npm's download dir across builds (BuildKit) -> much faster rebuilds.
RUN --mount=type=cache,target=/root/.npm npm ci

# A minimal node_modules (just mysql2 + its pure-JS deps) so the migrate/seed
# scripts can run inside the runtime image without shipping the whole bundle.
RUN --mount=type=cache,target=/root/.npm \
    npm install --prefix /app/runtime-deps --omit=dev --ignore-scripts mysql2@3.23.2

# Copy source (respects .dockerignore) and compile the app.
COPY . .
RUN npm run build

# ---------- Stage 2: runtime ----------
FROM node:22-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=3000
# Versi image (sha-xxxxxxx) — dilaporkan ke Kesehatan Sistem & ke pusat (instalasi klien).
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
WORKDIR /app

# Non-root user (alpine busybox adduser).
RUN addgroup -S app && adduser -S -G app app \
    && mkdir -p /app/storage \
    && chown -R app:app /app

# The Nitro build is self-contained — ship only what's needed to run.
COPY --from=build --chown=app:app /app/.output ./.output
COPY --from=build --chown=app:app /app/package.json ./package.json

# DB tooling for in-container migrate/seed (mysql2 + scripts + SQL files).
COPY --from=build --chown=app:app /app/runtime-deps/node_modules ./node_modules
COPY --from=build --chown=app:app /app/scripts ./scripts
COPY --from=build --chown=app:app /app/db ./db

USER app
EXPOSE 3000

# Env is injected by compose (env_file / environment); .env file is optional.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "--env-file-if-exists=.env", ".output/server/index.mjs"]
