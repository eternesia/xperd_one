# XPERD — pengaturan server klien (self-hosted)
# install.sh membuat .env dari berkas ini dan mengisi rahasia acak secara otomatis.
# Baris bertanda [PUSAT] disalin dari Super Admin pusat → Instalasi klien → (instalasi) → Token baru.

# ── Alamat ──────────────────────────────────────────────────────────────────
# Alamat publik aplikasi di server ini (subdomain klien), tanpa garis miring di akhir.
APP_PUBLIC_URL=https://erp.contoh-klien.co.id
WEB_PORT=3000

# ── Kendali pusat ───────────────────────────────────────────────────────────
XPERD_INSTANCE_MODE=self_hosted
# [PUSAT] alamat server pusat
XPERD_CONTROL_URL=https://xperd.id
# [PUSAT] token instalasi (xpi_…)
XPERD_INSTANCE_TOKEN=
# [PUSAT] kunci publik lisensi (satu baris)
XPERD_LICENSE_PUBLIC_KEY=

# Kode sekali pakai untuk halaman /setup (membuat perusahaan & admin pertama).
XPERD_SETUP_CODE=

# ── Rahasia (diisi install.sh) ──────────────────────────────────────────────
APP_JWT_SECRET=
VAULT_ENCRYPTION_KEY=
CRON_SECRET=

# ── Database (MySQL 8.4 LTS di container `mysql`) ───────────────────────────
MYSQL_DATABASE=xperd
MYSQL_USER=xperd
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Image aplikasi ──────────────────────────────────────────────────────────
# Gunakan tag sha-xxxxxxx untuk mengunci versi; latest = versi terbaru dari pusat.
APP_IMAGE=ghcr.io/eternesia/xperd_one:latest
