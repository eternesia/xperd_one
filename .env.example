# Salin menjadi .env lalu sesuaikan. JANGAN commit .env yang berisi rahasia.
# Referensi lengkap: OPERATIONS.md

# --- Aplikasi ---
PORT=3999
NODE_ENV=development
# WAJIB di produksi: kunci tanda tangan JWT sesi (buat dengan: openssl rand -hex 32)
APP_JWT_SECRET=change-me-development-secret

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=xperd
MYSQL_PASSWORD=xperd
MYSQL_DATABASE=xperd
MYSQL_POOL_SIZE=10
# Cache pernyataan siap-pakai per koneksi (bawaan mysql2 16000 bisa menghabiskan max_prepared_stmt_count server)
MYSQL_MAX_PREPARED=200

# --- Alamat publik aplikasi (WAJIB di produksi di balik proxy/HTTPS) ---
# Dipakai untuk tautan media bertanda tangan. Tanpa slash di akhir. (Tujuan kembali pembayaran DOKU juga TIDAK memakainya: ikut domain yang dipakai pengguna, https di balik proxy.)
# (Login Google TIDAK memakainya: Redirect URI mengikuti domain yang sedang dipakai pengguna, path tetap
#  /api/public/auth/google/callback — daftarkan satu URI per domain, mis. https://qalling.id/... dan https://xperd.id/...)
# APP_PUBLIC_URL=https://qalling.id

# --- Login Google (Qalling): OAuth Client dari Google Cloud Console ---
# Pilih salah satu: isi di sini (env) ATAU dari UI Admin → Login & Pendaftaran. Nilai dari UI (DB) lebih diutamakan bila ada.
# Authorized redirect URI di Google: https://<domain>/api/public/auth/google/callback (satu per domain yang dipakai)
# GOOGLE_CLIENT_ID=123456-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Berkas unggahan (opsional; default ./storage di dev, /app/storage di produksi) ---
# STORAGE_DIR=/abs/path/ke/storage

# --- Hook cron auto-publish postingan sosial (WAJIB di produksi) ---
# SOCIAL_PUBLISH_SECRET=rahasia-panjang
# Rahasia cron perpanjangan langganan (jam-an); kosong → memakai SOCIAL_PUBLISH_SECRET, keduanya kosong → 403
# CRON_SECRET=rahasia-panjang-lain

# --- Permukaan Qalling standalone (opsional; default qalling.id/qalling.net + www) ---
# VITE_QALLING_HOSTS=qalling.id,www.qalling.id,qalling.net,www.qalling.net

# --- Super admin & notifikasi (opsional) ---
# SUPERADMIN_EMAIL=admin@contoh.id
# WA_REMINDER_TO=62812xxxxxxx

# --- Port host untuk docker compose ---
WEB_PORT=3000

# --- TIDAK perlu env: dikonfigurasi dari UI (disimpan di DB, tulis-saja) ---
# Google Client ID/Secret (Admin → Login & Pendaftaran; atau lewat env GOOGLE_CLIENT_ID/SECRET di atas), Midtrans & DOKU (Admin → Payments), Tebar (Admin → Tebar),
# gateway email (Admin → Email), storage eksternal (Admin → Storage), Meta App (Qalling CRM → Akun Sosial).

# --- Hanya untuk uji (server tiruan; biarkan kosong di produksi) ---
# GOOGLE_OAUTH_BASE=      GOOGLE_OAUTH_AUTH_BASE=
# DOKU_API_BASE=          META_GRAPH_BASE=          TEBAR_API_BASE=

# --- Domain Qalling bersih (qalling.id tanpa /qalling) ---
# Router menerjemahkan alamat bersih otomatis untuk host qalling.id / www.qalling.id / qalling.net / www.qalling.net.
# Host tambahan (pisah koma; dibaca saat BUILD untuk bundel klien): VITE_QALLING_HOSTS=app.qalling.example
# Opsional, runtime: alihkan permanen alamat lama /qalling/* ke alamat bersih (aktifkan HANYA setelah proxy tidak lagi menulis ulang path):
# QALLING_LEGACY_REDIRECT=1

